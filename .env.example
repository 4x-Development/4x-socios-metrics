# ====================================================================
# Dashboard de Métricas — Variables de entorno
# ====================================================================
#
# Copiá este archivo a `.env` (que está gitignored) y completá los valores.
#
# Cada club tiene su propia base de datos. Las DBs pueden estar en
# servidores distintos, así que cada connection string es independiente.
#
# Formato de connection string SQL Server (mssql node-mssql):
#   Server=<host>,<port>;Database=<db>;User Id=<user>;Password=<pass>;Encrypt=True;TrustServerCertificate=True
#
# Si una variable falta, ese club se omite en runtime (no rompe nada,
# pero el club no aparece en las métricas hasta que se complete).
# ====================================================================

# ---------- Clubes ----------
DB_CONN_SOCIAL=
DB_CONN_FERRO=
DB_CONN_SOCIAL_DEP=
DB_CONN_SARMIENTO=
DB_CONN_INDEPENDIENTE=
DB_CONN_NAYTUEL=
DB_CONN_IFC_CASTELLI=
DB_CONN_CAI=

# ---------- Comportamiento general ----------
# Si vale "true", el dashboard usa los datos mock aunque haya env vars de DB.
# Útil para diseñar UI sin tocar producción.
USE_MOCK_DATA=true

# Timeout por query, en ms (default: 15000).
DB_QUERY_TIMEOUT_MS=15000

# Pool de conexiones por club: tamaño máximo (default: 5).
DB_POOL_MAX=5
