---
interface Props {
  title?: string;
  description?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const { title, description, padding = 'md' } = Astro.props;
const padClass = padding === 'sm' ? 'p-4' : padding === 'lg' ? 'p-8' : 'p-5 sm:p-6';
---

<div class={`rounded-xl border border-ink-200 bg-white ${padClass}`}>
  {(title || description) && (
    <header class="mb-4">
      {title && <h3 class="text-base font-bold text-ink-900">{title}</h3>}
      {description && <p class="mt-0.5 text-xs text-ink-500">{description}</p>}
    </header>
  )}
  <slot />
</div>
