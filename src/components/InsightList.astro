---
import type { Insight } from '@lib/insights';

interface Props {
  insights: Insight[];
}

const { insights } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    insights.map((i) => (
      <li
        class:list={[
          'flex items-start gap-3 rounded-lg border p-3.5 text-sm',
          i.kind === 'positive' && 'border-positive-500/30 bg-positive-50 text-positive-700',
          i.kind === 'negative' && 'border-negative-500/30 bg-negative-50 text-negative-700',
          i.kind === 'neutral' && 'border-ink-200 bg-ink-50 text-ink-700',
        ]}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0">
          {i.kind === 'positive' ? (
            <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke="currentColor" stroke-width="2" fill="none" />
          ) : i.kind === 'negative' ? (
            <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke="currentColor" stroke-width="2" fill="none" />
          ) : (
            <path d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" stroke="currentColor" stroke-width="2" fill="none" />
          )}
        </svg>
        <span>{i.text}</span>
      </li>
    ))
  }
</ul>
