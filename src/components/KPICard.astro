---
import Trend from './Trend.astro';

interface Props {
  label: string;
  value: string;
  current?: number;
  previous?: number;
  positiveWhenUp?: boolean;
  hint?: string;
  icon?: 'currency' | 'users' | 'percent' | 'clock' | 'spark';
}

const { label, value, current, previous, positiveWhenUp = true, hint, icon } = Astro.props;

const iconPaths: Record<string, string> = {
  currency:
    'M12 2.25a.75.75 0 0 1 .75.75v.75h2.25a.75.75 0 0 1 0 1.5H8.625a1.875 1.875 0 0 0 0 3.75h6.75a3.375 3.375 0 0 1 0 6.75H12.75V21a.75.75 0 0 1-1.5 0v-1.5H9a.75.75 0 0 1 0-1.5h6.375a1.875 1.875 0 0 0 0-3.75h-6.75a3.375 3.375 0 0 1 0-6.75H11.25V3a.75.75 0 0 1 .75-.75Z',
  users:
    'M4.5 6.375a4.125 4.125 0 1 1 8.25 0 4.125 4.125 0 0 1-8.25 0Zm9.5 1.5a3.375 3.375 0 1 0 6.75 0 3.375 3.375 0 0 0-6.75 0Z',
  percent:
    'M18.97 3.659a2.25 2.25 0 0 0-3.182 0l-10.94 10.94a3.375 3.375 0 1 0 4.773 4.772l10.94-10.94a2.25 2.25 0 0 0 0-3.181l-1.59-1.591ZM12 8.25a.75.75 0 0 0 0-1.5.75.75 0 0 0 0 1.5Zm7.5 7.5a.75.75 0 0 0 0-1.5.75.75 0 0 0 0 1.5Z',
  clock:
    'M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5Zm.75 4.5a.75.75 0 0 0-1.5 0v5.69l3.97 2.29a.75.75 0 0 0 .75-1.3l-3.22-1.86V6.75Z',
  spark:
    'M3 17l4-6 4 4 6-9 4 7v3H3v-1Z',
};
---

<div class="rounded-xl border border-ink-200 bg-white p-5">
  <div class="flex items-start justify-between">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-ink-500">{label}</p>
    {
      icon && (
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-navy-50 text-navy-700">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d={iconPaths[icon]} clip-rule="evenodd" />
          </svg>
        </span>
      )
    }
  </div>

  <p class="mt-2 text-2xl font-extrabold text-ink-900 tabular sm:text-3xl">{value}</p>

  <div class="mt-3 flex items-center gap-2">
    {current !== undefined && previous !== undefined && (
      <Trend current={current} previous={previous} positiveWhenUp={positiveWhenUp} />
    )}
    {hint && <span class="text-xs text-ink-500">{hint}</span>}
  </div>
</div>
