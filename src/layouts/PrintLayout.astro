---
/**
 * Minimal layout for printable / PDF-exportable views.
 *
 * - No sidebar, no topbar — content takes the full page.
 * - White background, dark text, tight typography.
 * - Browser print dialog opens via the toolbar button (or Ctrl+P).
 * - The toolbar is hidden on print (`print:hidden`).
 * - `@page` defines A4 with reasonable margins.
 */

import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      @page {
        size: A4;
        margin: 1.4cm 1.6cm;
      }
      @media print {
        body { background: white !important; }
      }
    </style>
  </head>
  <body class="antialiased bg-white text-ink-900">
    <!-- Toolbar visible only on screen -->
    <div class="sticky top-0 z-10 border-b border-ink-200 bg-white shadow-sm print:hidden">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-3">
        <a
          href="javascript:history.back()"
          class="text-sm font-medium text-ink-600 hover:text-ink-900"
        >
          ← Volver
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-2 rounded-md bg-navy-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-navy-800"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path
              fill-rule="evenodd"
              d="M7.875 1.5C6.839 1.5 6 2.34 6 3.375v2.99c-.426.053-.851.11-1.274.174-1.454.218-2.476 1.483-2.476 2.917v6.294a3 3 0 0 0 3 3h.27l-.155 1.705A1.875 1.875 0 0 0 7.232 22.5h9.536a1.875 1.875 0 0 0 1.867-2.045l-.155-1.705h.27a3 3 0 0 0 3-3V9.456c0-1.434-1.022-2.7-2.476-2.917A48.716 48.716 0 0 0 18 6.366V3.375c0-1.036-.84-1.875-1.875-1.875h-8.25ZM16.5 6.205v-2.83A.375.375 0 0 0 16.125 3h-8.25a.375.375 0 0 0-.375.375v2.83a49.353 49.353 0 0 1 9 0Zm-.217 8.265c.178.018.317.16.333.337l.526 5.784a.375.375 0 0 1-.374.409H7.232a.375.375 0 0 1-.374-.409l.526-5.784a.373.373 0 0 1 .333-.337 41.741 41.741 0 0 1 8.566 0Zm.967-3.97a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75v-.008Z"
              clip-rule="evenodd"
            />
          </svg>
          Imprimir / Guardar como PDF
        </button>
      </div>
    </div>

    <main class="mx-auto max-w-4xl px-6 py-8 print:max-w-none print:px-0 print:py-0">
      <slot />
    </main>
  </body>
</html>
