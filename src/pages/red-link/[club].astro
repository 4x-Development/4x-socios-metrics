---
import Layout from '@layouts/Layout.astro';
import DataSourceBanner from '@components/DataSourceBanner.astro';
import EmptyState from '@components/EmptyState.astro';
import RedLinkSection from '@components/RedLinkSection.astro';

import { clubs, getClub, hasClubConnection, loadRedLinkSummary } from '@db';

/**
 * Red Link deep-dive page — per-club static route.
 *
 * Uses `getStaticPaths` to generate a separate static page per club
 * (`/red-link/independiente`, `/red-link/social`, ...), so the club id
 * is part of the page identity and the page is correctly re-rendered
 * per club in static mode.
 *
 * The dropdown navigates to the new path on change. No client-side
 * framework — just a vanilla `<select onchange>` that updates location.
 *
 * Queries hit Red Link tables exclusively (ExtractRedLink* and RefreshRedLink*).
 */

export async function getStaticPaths() {
  return clubs.map((c) => ({ params: { club: c.id } }));
}

const { club: clubId } = Astro.params;
const club = getClub(clubId!);
if (!club) {
  return Astro.redirect('/red-link');
}

const { data: redLink, reason } = await loadRedLinkSummary(club.id, 6);
const periodLabel = `Últimos 6 meses · ${club.name}`;
---

<Layout title="Red Link" subtitle={periodLabel}>
  <!-- Toolbar: club selector + export to PDF -->
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <label
        for="club-select"
        class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500"
      >
        Club
      </label>
      <select
        id="club-select"
        onchange="if (this.value) window.location.href = '/red-link/' + this.value;"
        class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm font-medium text-ink-900 transition focus:border-navy-400 focus:outline-none focus:ring-2 focus:ring-navy-100 sm:max-w-sm"
      >
        {
          clubs.map((c) => (
            <option value={c.id} selected={c.id === club.id}>
              {c.shortName} · {c.city} {hasClubConnection(c.id) ? '— en vivo' : '— sin conexión'}
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/red-link/consolidado"
        class="inline-flex items-center justify-center gap-2 rounded-md border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-900 shadow-sm transition hover:border-navy-300 hover:bg-navy-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M2.25 13.5a8.25 8.25 0 0 1 8.25-8.25.75.75 0 0 1 .75.75v6.75H18a.75.75 0 0 1 .75.75 8.25 8.25 0 0 1-16.5 0Z" clip-rule="evenodd" />
          <path fill-rule="evenodd" d="M12.75 3a.75.75 0 0 1 .75-.75 8.25 8.25 0 0 1 8.25 8.25.75.75 0 0 1-.75.75h-7.5a.75.75 0 0 1-.75-.75V3Z" clip-rule="evenodd" />
        </svg>
        Resumen consolidado
      </a>
      <a
        href={`/red-link/${club.id}/print`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 rounded-md border border-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-900 shadow-sm transition hover:border-navy-300 hover:bg-navy-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z" clip-rule="evenodd" />
          <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
        </svg>
        Exportar PDF
      </a>
    </div>
  </div>

  <DataSourceBanner
    included={redLink ? [club] : []}
    excluded={redLink ? [] : [{ id: club.id, name: club.name, reason: reason ?? 'Sin datos' }]}
  />

  {
    redLink === null ? (
      <EmptyState
        title="Sin datos de Red Link para este club"
        detail={reason}
      />
    ) : (
      <RedLinkSection summary={redLink} />
    )
  }
</Layout>
